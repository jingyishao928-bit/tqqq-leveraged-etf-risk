.DS_Store
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.idea/
.vscode/
.env
*.key
*.pem

# Temporary and cache files
tmp/
cache/
*.log

# Keep directory placeholders, but do not commit unreviewed downloads.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/metadata/*
!data/metadata/.gitkeep

# Generated outputs are reviewed before being force-added for a release.
outputs/part[1-5]/**
!outputs/part[1-5]/**/
!outputs/part[1-5]/**/.gitkeep
# Part 1 analysis source is stored alongside its reviewed results.
!outputs/part1/analyze_part1.py
